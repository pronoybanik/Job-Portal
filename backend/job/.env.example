NODE_ENV=development
PORT=5003

DB_URI=postgresql://user:password@localhost:5432/jobs?schema=public
JWT_EXPIRES_IN=2h
JWT_SECRET=change_me
UPLOAD_SERVICE=http://localhost:5001

# Comma-separated Kafka broker addresses
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=job-service
KAFKA_JOB_TOPIC=job-events
KAFKA_MAIL_TOPIC=send-mail
AUTH_SERVICE_URL=http://localhost:5000
KAFKA_MAIL_GROUP_ID=job-portal-mail-service
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=Job Portal <your_email@gmail.com>
